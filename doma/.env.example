# Обязательные
BOT_TOKEN=123456:replace-me
DATABASE_URL=postgresql+asyncpg://doma:doma@localhost:5432/doma

# Часовой пояс по умолчанию (предлагается при создании дома, не применяется молча)
DEFAULT_TIMEZONE=Europe/Astrakhan

# Логирование: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ИИ (опционально). Пока AI_ENABLED=false — работают шаблоны и fake-адаптер в тестах.
AI_ENABLED=false
AI_PROVIDER=fake
# Для openai-совместимого API (после выбора провайдера владельцем):
# AI_PROVIDER=openai_compatible
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_REQUESTS_PER_HOUSEHOLD_PER_DAY=3
